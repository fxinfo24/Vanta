# ProfileScope Environment Configuration
# Copy this file to .env and fill in your API credentials

# Twitter API Credentials
# Get these from https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Facebook API Credentials  
# Get these from https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here

# Flask Configuration
FLASK_APP=app.web.app
FLASK_SECRET_KEY=your_secret_key_for_flask_sessions
SECRET_KEY=your_secret_key_for_flask_sessions
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# CORS Configuration (comma-separated list of allowed origins)
# For production, set to your frontend URL(s)
# Example: https://yourapp.vercel.app,https://yourdomain.com
# Railway: Set this in your environment variables to include your Vercel deployment URL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://profile-scope.vercel.app

# Database Configuration
DATABASE_URI=sqlite:///data/profilescope.db

# Redis Configuration (for Celery background tasks)
# Local development: redis://localhost:6379/0
# Railway production: Automatically provided by Railway Redis add-on
# Leave blank to use threading fallback (no Redis required)
REDIS_URL=redis://localhost:6379/0

# OpenRouter API Key (for AI-powered analysis)
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override LLM model (default verified live: nvidia/nemotron-3-ultra-550b-a55b:free)
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Privacy: inferring political opinions, religion, intimate-relationship patterns and
# substance use are special-category attributes under GDPR Art. 9, inferred here about
# people who did not consent. They stay OFF unless a deployment deliberately opts in
# (and has the lawful basis to do so). See directives/CODEBASE_ASSESSMENT.md §5.
ALLOW_SPECIAL_CATEGORY_INFERENCE=false

# Retention: days before collected posts / quoted evidence are purged. Snapshot
# metrics are kept separately, so trend history survives the purge.
# RAW_CONTENT_DAYS=30
# QUOTE_RECEIPT_DAYS=90
# SNAPSHOT_DAYS=365

# ScrapeCreators API Key (for social media data collection)
# Get from: https://scrapecreators.com/
SCRAPECREATORS_API_KEY=your_scrapecreators_api_key_here

# Apify API Token (for Actor-based data collection — alternative to ScrapeCreators)
# Get from: https://console.apify.com/settings/integrations  (Authorization: Bearer)
# Apify = scraping/data. OpenRouter = LLM analysis. You need BOTH for full pipeline:
# Apify fetches raw profile/post data, OpenRouter analyses it. Neither replaces the other.
APIFY_API_TOKEN=your_apify_api_token_here
# Optional: override actor per platform (user~actor-name)
# APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
# APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
# APIFY_ACTOR_TWITTER=quikr/twitter-scraper

# Optional: Force Celery mode (leave blank to use threading)
# Set to "true" only if you have Redis + Celery worker running
FORCE_CELERY=false

# Optional: ProfileScope Configuration File Path
PROFILESCOPE_CONFIG=config/config.json